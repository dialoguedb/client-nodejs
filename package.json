{
  "name": "dialogue-db",
  "version": "0.0.1",
  "description": "TypeScript SDK for DialogueDB - managed database service for AI memory and conversation management",
  "keywords": [
    "ai",
    "llm",
    "chat",
    "prompt",
    "memory",
    "context"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:package": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "(concurrently \"tsc -w\" \"tsc-alias -w\")",
    "test": "jest --config jest.config.ts --maxWorkers 3 --coverage",
    "format:check": "prettier --check \"src\"",
    "format:write": "prettier --write \"src\"",
    "prepublish": "npm run build:package",
    "publish": "npm publish"
  },
  "author": "DialogueDB",
  "dependencies": {
    "node-fetch": "^2.7.0",
    "p-retry": "^4.6.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^17.0.45",
    "@types/node-fetch": "^2.6.11",
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.6.6",
    "tsconfig-paths": "^3.14.1",
    "tsup": "^8.4.0",
    "typescript": "^4.9.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialoguedb/client-nodejs.git"
  },
  "homepage": "https://dialoguedb.com"
}
